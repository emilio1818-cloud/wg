{
  "name": "nestly",
  "version": "1.0.0",
  "private": true,
  "description": "Nestly – die All-in-one App für WGs: Geld teilen, Putzplan, Einkaufslisten, Verträge, Fixkosten und Kalender.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "screenshots": "node scripts/screenshots.mjs",
    "start": "node server/src/index.ts",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc -p core && tsc -p server && tsc -p app --noEmit",
    "test": "node --test --test-reporter=spec \"core/test/*.test.ts\" \"server/test/*.test.ts\" \"app/test/*.test.ts\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.mjs\"",
    "icons": "node scripts/icons.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^6.0.2",
    "playwright": "^1.50.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/emilio1818-cloud/wg.git"
  },
  "keywords": [
    "wg",
    "flatshare",
    "roommates",
    "splitwise-alternative",
    "chores",
    "shopping-list",
    "pwa",
    "offline-first"
  ]
}
