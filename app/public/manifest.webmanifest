{
  "name": "Nestly – Die WG-App",
  "short_name": "Nestly",
  "description": "Ausgaben teilen, Putzplan, Einkaufslisten, Verträge, Fixkosten und Kalender für eure WG.",
  "id": "./",
  "start_url": "./#/",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#f4f3f9",
  "theme_color": "#6b4ef6",
  "lang": "de",
  "dir": "ltr",
  "categories": ["lifestyle", "productivity", "finance"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Ausgabe eintragen", "short_name": "Ausgabe", "url": "./#/money", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Einkaufsliste", "short_name": "Einkauf", "url": "./#/shopping", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Putzplan", "short_name": "Putzplan", "url": "./#/chores", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
